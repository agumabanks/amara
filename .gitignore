# Evidence/artifact dumps live at the repo root. Anchor the rule to the root so it
# cannot swallow production source directories that happen to be named "artifacts" —
# app/src/main/kotlin/co/sanaa/agent/core/artifacts/ contains ArtifactEngine.kt and
# ArtifactDelivery.kt, which the whole build depends on, and the unanchored rule
# excluded them from the repository, breaking every clean checkout at
# :app:compileDebugKotlin.
/artifacts/
evidence/
deleted-tenants-sql-backups-*.zip
Untitled-*.log
*.log
.DS_Store
mission/amara-10-10/progress.json

/*.png
/*.xml
/*.md
!/.gitignore
!/.editorconfig
!/RELEASE.md
!/README.md
!/app/src/main/AndroidManifest.xml
!/app/src/main/res/xml/*.xml
