root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gradle,kt,kts,java,xml,yml,yaml,properties}]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 140
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.md]
trim_trailing_whitespace = false
